{
  "name": "hello-internet",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^15.0.0-beta.3",
    "@astrojs/react": "^7.0.0",
    "@emdash-cms/cloudflare": "1.3.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "astro": "^7.4.1",
    "emdash": "1.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/config": "^0.27.0",
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.3",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/three": "^0.186.0",
    "cf": "^1.0.0-beta.24",
    "esbuild": "^0.28.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@astrojs/cloudflare": "$@astrojs/cloudflare"
  },
  "allowScripts": {
    "fsevents": true,
    "workerd": true
  },
  "scripts": {
    "dev": "npm run build:trail && cf dev",
    "build": "npm run build:trail && cf build",
    "deploy": "npm run build:trail && cf deploy --worker hello-app && cf deploy",
    "build:trail": "node scripts/build-trail.mjs",
    "deploy:app": "npm run build:trail && cf deploy --worker hello-app",
    "check": "astro check && tsc --project tsconfig.workers.json"
  }
}
