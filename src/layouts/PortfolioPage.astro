---
interface Props { title: string; section?: string; description?: string; type?: string; content?: unknown; }
const { title, section = 'projects', description = title + ' · Srikar Kolipaka' } = Astro.props;
const navigation = [['about','About me','/about'],['hobbies','Hobbies','/hobbies'],['projects','Projects','/work'],['career','Career','/career'],['contact','Contact','/contact']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="theme-color" content="#234437" /><meta name="description" content={description} /><title>{title} · Srikar Kolipaka</title><link rel="icon" href="/favicon.svg" /><link rel="stylesheet" href="/portfolio/pages.css" /></head><body class={`page-${section}`}><a class="skip" href="#main">Skip to content</a><header class="page-nav"><a class="page-brand" href="/"><b>sk.</b><span>Srikar Kolipaka</span></a><nav aria-label="Main navigation">{navigation.map(([id,label,url]) => <a href={url} aria-current={section === id ? 'page' : undefined}>{label}</a>)}</nav></header><main id="main" class="page-content"><slot /></main><footer class="page-footer"><a href="/">← Back to the view</a><div><a href="mailto:srikarrkolipaka@gmail.com">Email</a><a href="https://github.com/SrikarrKoli">GitHub ↗</a><a href="https://linkedin.com/in/srikar-kolipaka">LinkedIn ↗</a></div></footer></body></html>
